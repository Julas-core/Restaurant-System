<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaproject.AdminUsersController" styleClass="page">

    <!-- Sidebar -->
    <left>
        <VBox spacing="5" prefWidth="250" styleClass="sidebar">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10" />
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets bottom="30" left="15" />
                </padding>
                <Label text="🍽" style="-fx-font-size: 24px;" />
                <Label text="RestoAdmin" styleClass="brand" />
            </HBox>

            <Button text="Dashboard" styleClass="sidebar-item" maxWidth="Infinity" onAction="#goDashboard" />
            <Button text="Orders" styleClass="sidebar-item" maxWidth="Infinity" onAction="#goOrders" />
            <Button text="Menu Management" styleClass="sidebar-item" maxWidth="Infinity" onAction="#goMenu" />
            <Button text="Customers" styleClass="sidebar-item, sidebar-active" maxWidth="Infinity" onAction="#goUsers" />
            <Button text="Feedback" styleClass="sidebar-item" maxWidth="Infinity" onAction="#goFeedback" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button text="Settings" styleClass="sidebar-item" maxWidth="Infinity" />
            <Button text="Logout" styleClass="sidebar-item" maxWidth="Infinity" onAction="#doLogout" />
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="25">
                    <padding>
                        <Insets top="25" right="30" bottom="30" left="30" />
                    </padding>

                    <!-- Top Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox>
                            <Label text="User Management" styleClass="section-title" />
                            <Label text="Manage system access, user roles, and verify discount eligibility." styleClass="muted" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="+ Add New User" styleClass="primary-button" />
                    </HBox>

                    <!-- Stats Cards -->
                    <HBox spacing="20">
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Total Users" styleClass="stat-label" />
                            <Label text="1,240" styleClass="stat-value" />
                            <Label text="↗ +5%">
                                <styleClass>
                                    <String fx:value="badge" />
                                    <String fx:value="badge-success" />
                                </styleClass>
                            </Label>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Active Discounts" styleClass="stat-label" />
                            <Label text="350" styleClass="stat-value" />
                            <Label text="↗ +12%">
                                <styleClass>
                                    <String fx:value="badge" />
                                    <String fx:value="badge-success" />
                                </styleClass>
                            </Label>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="Pending Verifications" styleClass="stat-label" />
                            <Label text="12" styleClass="stat-value" />
                            <Label text="! Action Needed">
                                <styleClass>
                                    <String fx:value="badge" />
                                    <String fx:value="badge-danger" />
                                </styleClass>
                            </Label>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <Label text="New This Month" styleClass="stat-label" />
                            <Label text="45" styleClass="stat-value" />
                            <Label text="↗ +8%">
                                <styleClass>
                                    <String fx:value="badge" />
                                    <String fx:value="badge-success" />
                                </styleClass>
                            </Label>
                        </VBox>
                    </HBox>

                    <!-- Filters -->
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                        <Button text="All Users" styleClass="secondary-button" style="-fx-background-color: #333; -fx-text-fill: white;" />
                        <Button text="Filters" styleClass="secondary-button" />
                        <Button text="Staff x" styleClass="secondary-button" style="-fx-text-fill: #f05a28; -fx-border-color: #f05a28;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Export" styleClass="secondary-button" />
                    </HBox>

                    <!-- Table -->
                    <VBox styleClass="card">
                        <TableView fx:id="usersTable" minHeight="400">
                            <columns>
                                <TableColumn fx:id="colIdentity" text="User Identity" prefWidth="200" />
                                <TableColumn fx:id="colRole" text="Role" prefWidth="100" />
                                <TableColumn fx:id="colDiscount" text="Discount" prefWidth="120" />
                                <TableColumn fx:id="colAction" text="Actions" prefWidth="100" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>