<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaproject.PageController" styleClass="page">

    <top>
        <BorderPane styleClass="topbar">
            <padding>
                <Insets top="12" right="18" bottom="12" left="18" />
            </padding>
            <left>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="◆" styleClass="brand-mark" />
                    <Label text="Gourmet Haven" styleClass="brand" />
                    <Region prefWidth="20" />
                    <Button text="Home" styleClass="nav-link" onAction="#goToHome" />
                    <Button text="Menu" styleClass="nav-link" onAction="#goToMenu" />
                    <Button text="About" styleClass="nav-link, nav-active" onAction="#goToAbout" />
                    <Button text="Contact" styleClass="nav-link" onAction="#goToContact" />
                    <Button text="Location" styleClass="nav-link" onAction="#goToLocation" />
                </HBox>
            </left>
            <right>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="🛒" styleClass="icon-button" onAction="#goToCheckout" />
                    <Button text="👤" styleClass="icon-button" onAction="#goToProfile" />
                </HBox>
            </right>
        </BorderPane>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="20" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="40" right="40" bottom="40" left="40" />
                    </padding>
                    <Label text="About Us" styleClass="section-title" />
                    <Label text="Welcome to Gourmet Haven, where passion meets plate. Established in 2020, we serve the finest culinary delights made from locally sourced ingredients." wrapText="true" maxWidth="600" styleClass="muted" />
                    <Label text="Our Mission" styleClass="kicker" />
                    <Label text="To provide an unforgettable dining experience with every bite." wrapText="true" maxWidth="600" styleClass="muted" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
