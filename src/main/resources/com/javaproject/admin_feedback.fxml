<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaproject.AdminFeedbackController" styleClass="page">

    <!-- Sidebar -->
    <left>
        <VBox spacing="5" prefWidth="250" styleClass="sidebar">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10" />
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets bottom="30" left="15" />
                </padding>
                <Label text="🍽" style="-fx-font-size: 24px;" />
                <Label text="RestoAdmin" styleClass="brand" />
            </HBox>

            <Button text="Dashboard" styleClass="sidebar-item" maxWidth="Infinity" onAction="#goDashboard" />
            <Button text="Orders" styleClass="sidebar-item" maxWidth="Infinity" onAction="#goOrders" />
            <Button text="Menu Management" styleClass="sidebar-item" maxWidth="Infinity" onAction="#goMenu" />
            <Button text="Customers" styleClass="sidebar-item" maxWidth="Infinity" onAction="#goUsers" />
            <Button text="Feedback" styleClass="sidebar-item, sidebar-active" maxWidth="Infinity" onAction="#goFeedback" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button text="Settings" styleClass="sidebar-item" maxWidth="Infinity" />
            <Button text="Logout" styleClass="sidebar-item" maxWidth="Infinity" onAction="#doLogout" />
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="25">
                    <padding>
                        <Insets top="25" right="30" bottom="30" left="30" />
                    </padding>

                    <!-- Top Bar -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox>
                            <Label text="Feedback Management" styleClass="section-title" />
                            <Label text="View and manage customer reviews and ratings" styleClass="muted" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Export Report" styleClass="primary-button" style="-fx-background-color: #0d6efd;" />
                    </HBox>

                    <!-- Stats Cards -->
                    <HBox spacing="20">
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="AVERAGE RATING" styleClass="stat-label" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="★" style="-fx-text-fill: #ffc107;" />
                            </HBox>
                            <Label text="4.8 / 5.0" styleClass="stat-value" />
                            <Label text="↗ +0.2% vs last month">
                                <styleClass>
                                    <String fx:value="badge" />
                                    <String fx:value="badge-success" />
                                </styleClass>
                            </Label>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="UNREAD REVIEWS" styleClass="stat-label" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="✉" style="-fx-text-fill: #f05a28;" />
                            </HBox>
                            <Label text="12" styleClass="stat-value" />
                            <Label text="Action Required">
                                <styleClass>
                                    <String fx:value="badge" />
                                    <String fx:value="badge-warning" />
                                </styleClass>
                            </Label>
                        </VBox>
                        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="TOTAL FEEDBACK" styleClass="stat-label" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="💬" style="-fx-text-fill: #0d6efd;" />
                            </HBox>
                            <Label text="1,240" styleClass="stat-value" />
                            <Label text="↗ +12% new reviews">
                                <styleClass>
                                    <String fx:value="badge" />
                                    <String fx:value="badge-success" />
                                </styleClass>
                            </Label>
                        </VBox>
                    </HBox>

                    <!-- Filters -->
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                        <TextField promptText="Search by customer name..." styleClass="search" HBox.hgrow="ALWAYS" />
                        <Button text="Filter" styleClass="secondary-button" />
                        <Button text="Newest First" styleClass="secondary-button" />
                    </HBox>
                    
                    <HBox spacing="10">
                        <Button text="All Reviews" styleClass="secondary-button" style="-fx-background-color: #333; -fx-text-fill: white;" />
                        <Button text="Pending (3)" styleClass="secondary-button" />
                        <Button text="Handled" styleClass="secondary-button" />
                        <Button text="5 Stars" styleClass="secondary-button" />
                        <Button text="Negative (&lt;3)" styleClass="secondary-button" />
                    </HBox>

                    <!-- Reviews List -->
                    <VBox fx:id="reviewsList" spacing="15" />

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>