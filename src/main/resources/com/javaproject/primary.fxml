<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaproject.PrimaryController">
   <padding>
      <Insets top="12" right="12" bottom="12" left="12" />
   </padding>

   <top>
      <HBox spacing="10">
         <Label text="Restaurant App" />
         <Label fx:id="totalLabel" text="Total: $0.00" />
      </HBox>
   </top>

   <left>
      <VBox spacing="8" prefWidth="200">
         <Label text="Menu" />
         <ListView fx:id="menuListView" />
      </VBox>
   </left>

   <center>
      <VBox spacing="8">
         <Label text="Item Details" />
         <Label fx:id="itemNameLabel" text="Select an item" />
         <Label fx:id="itemDescriptionLabel" wrapText="true" />
         <Label fx:id="itemPriceLabel" />
         <Button fx:id="addToCartButton" mnemonicParsing="false" onAction="#addSelectedItemToCart" text="Add to Cart" />
      </VBox>
   </center>

   <right>
      <VBox spacing="8" prefWidth="240">
         <Label text="Cart" />
         <ListView fx:id="cartListView" />
         <Button fx:id="removeOneButton" mnemonicParsing="false" onAction="#removeSelectedCartLine" text="Remove One" />
         <Button fx:id="checkoutButton" mnemonicParsing="false" onAction="#switchToSecondary" text="Checkout" />
      </VBox>
   </right>
</BorderPane>
