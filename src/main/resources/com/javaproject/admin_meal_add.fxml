<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaproject.AdminAddMealController" style="-fx-padding: 20;">
    <Label text="Add New Meal" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    
    <Label text="Name" />
    <TextField fx:id="nameField" />
    
    <Label text="Category" />
    <ComboBox fx:id="categoryCombo" prefWidth="200" editable="true"/>

    <Label text="Description" />
    <TextArea fx:id="descriptionArea" prefHeight="60" />

    <Label text="Price" />
    <TextField fx:id="priceField" />
    
    <Label text="Label (e.g. Vegetarian, Spicy)" />
    <TextField fx:id="labelField" />

    <CheckBox fx:id="chefSpecialCheck" text="Chef's Special" />

    <Label text="Image" />
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Choose Image..." onAction="#chooseImage" />
        <Label fx:id="imagePathLabel" text="No file selected" />
    </HBox>
    <StackPane fx:id="imagePreviewContainer" prefWidth="100" prefHeight="100" maxHeight="100" maxWidth="100" style="-fx-background-color: #eee; -fx-border-color: #ccc;">
        <!-- Image will be set via CSS background -->
    </StackPane>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#cancel" />
        <Button text="Save" styleClass="primary-button" onAction="#save" />
    </HBox>
</VBox>
