<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javaproject.SecondaryController">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12" />
    </padding>

    <children>
        <Label text="Checkout" />
        <Label text="Order Summary" />
        <ListView fx:id="orderSummaryListView" />

        <HBox spacing="10">
            <Label fx:id="checkoutTotalLabel" text="Total: ETB 0.00" />
        </HBox>

        <HBox spacing="10">
            <Button mnemonicParsing="false" onAction="#switchToPrimary" text="Back" />
            <Button fx:id="placeOrderButton" mnemonicParsing="false" onAction="#placeOrder" text="Place Order" />
        </HBox>
    </children>
</VBox>
